objective_summary = "Đi qua chuỗi ba cổng đúng để tới sanctum; sai tối đa hai lần."
level_tags = PackedStringArray("campaign", "chapter_2", "coven_foundry", "cursed_gate_maze", "portal", "memory_route")
authoring_notes = "Chapter 2 data contract. Portal symbols and shapes, not color alone, define the three-step route. A wrong choice creates one short ambush, returns to the hub, and records a mistake; after two mistakes the correct symbol pulses and a hint prevents loops. No director spawn may land on a portal destination or within 96 px of it. First clear unlocks Salvage."
