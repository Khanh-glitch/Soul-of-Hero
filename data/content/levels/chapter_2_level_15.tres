display_name = "Kẻ Phá Khế"
content_status = 2
objective_summary = "Ép Axe đến đúng ngưỡng 50% HP và chứng kiến hắn chạy thoát."
level_tags = PackedStringArray("campaign", "chapter_2", "coven_foundry", "axe", "force_retreat", "midboss")
authoring_notes = "Chapter 2 data contract. Two short rooms contain eight Wraith total, followed by a checkpoint/heal directly before Axe's arena. Completion authority is axe_retreated only, after a clamped exact 50 percent threshold and idempotent escape. Axe must never die, emit death/mastery/loot, grant axe_hero, or produce an Axe Soul. The first-clear bundle contains only the non-Soul fractured_axe_insignia story key item and economy rewards."
campaign_slot = 15
chapter_number = 2
chapter_level_number = 5
