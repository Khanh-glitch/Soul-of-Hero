objective_summary = "Hạ Wizard rồi tự tay nhặt Wizard Soul vật lý trước khi lối ra mở."
level_tags = PackedStringArray("campaign", "chapter_2", "coven_foundry", "wizard", "final_boss", "physical_soul_pickup")
authoring_notes = "Chapter 2 data contract. Gate combat is six Wraith with at most one Leech add, then a checkpoint heals at least 75 percent and records loadout before Wizard's arena. Wizard death clears harmful actors but does not unlock exit or grant hero ownership. Runtime must spawn a recoverable physical Wizard Soul at a safe anchor and commit campaign:chapter_2_level_20:wizard_soul_pickup:v1 only on interaction; explicit Equip remains separate. This completion bundle grants economy plus Depth only and must never contain wizard_hero or a Hero Soul grant."
