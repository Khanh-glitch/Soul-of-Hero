entry_id = &"hooded_archer"
combatant_id = &"hooded_archer_miniboss"
unique = true
miniboss = true
authoring_notes = "Canonical Level 5 recruitment boss. Death releases a separate physical Archer Hero Soul pickup; the roster entry itself grants no ownership."

[resource]
resource_name = "Chapter 1 Level 5 Roster"
script = ExtResource("1_roster")
roster_id = &"chapter_1_level_5_roster"
campaign_slot = 5
authoring_notes = "10 Skeleton 1 + 5 Bone Reapers + one unique Vampire + one KingdomArcher miniboss. Only the regular Skeleton entries are elite-eligible."
entries = Array[ExtResource("2_entry")]([SubResource("SkeletonOne"), SubResource("SkeletonTwo"), SubResource("Vampire"), SubResource("HoodedArcher")])
elite_policy = ExtResource("3_policy")
