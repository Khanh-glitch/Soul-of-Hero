[resource]
resource_name = "Chapter 1 Level 5 - Blood Crucible"
script = ExtResource("1_encounter")
encounter_id = &"chapter_1_level_5_crypt"
display_name = "Blood Crucible and KingdomArcher"
encounter_tags = PackedStringArray("campaign", "chapter_1", "crypt", "blood", "dense_camps", "archer", "miniboss", "physical_soul_pickup")
authoring_notes = "Sixteen guardians lead into KingdomArcher. The exit requires both boss defeat and a successful physical pickup of the Normal Level 1 Archer Hero Soul."
waves = Array[ExtResource("4_wave")]([SubResource("CryptWave"), SubResource("ArcherWave")])
warnings = Array[ExtResource("5_warning")]([SubResource("EntryWarning")])
objectives = Array[ExtResource("6_objective")]([SubResource("ClearObjective"), SubResource("ArcherObjective"), SubResource("CollectArcherSoulObjective")])
completion = SubResource("Completion")
