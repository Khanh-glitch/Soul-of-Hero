[resource]
resource_name = "Chapter 1 Level 6 - Three Soul Anchors"
script = ExtResource("1")
encounter_id = &"chapter_1_level_6_soul_anchors"
display_name = "Three Soul Anchors"
encounter_tags = PackedStringArray("campaign", "chapter_1", "relay", "soul_anchor")
authoring_notes = "Runtime-ready draft encounter: three Bone Reaper manifestations emit counted Soul Anchor events, all nine guards must also fall, and both Relay directions are tracked as optional non-blocking lesson objectives."
waves = Array[ExtResource("4")]([SubResource("Wave")])
warnings = Array[ExtResource("5")]([SubResource("RelayWarning")])
objectives = Array[ExtResource("6")]([SubResource("AnchorObjective"), SubResource("ClearObjective"), SubResource("SwordToArcherObjective"), SubResource("ArcherToSwordObjective")])
completion = SubResource("Completion")
