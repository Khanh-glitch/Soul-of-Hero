[resource]
resource_name = "Chapter 1 Level 7 - The Failing Beacon"
script = ExtResource("1")
encounter_id = &"chapter_1_level_7_beacon_defense"
display_name = "The Failing Beacon"
encounter_tags = PackedStringArray("campaign", "chapter_1", "defense", "mixed_waves", "soul_beacon")
authoring_notes = "Runtime-ready three-wave defense. The dedicated controller only activates authored markers in order; EncounterRuntimeState remains the sole gate/completion authority and receives one survival event after all sixteen enemies die while the Beacon is alive."
waves = Array[ExtResource("4")]([SubResource("Wave1"), SubResource("Wave2"), SubResource("Wave3")])
warnings = Array[ExtResource("5")]([SubResource("Warning")])
objectives = Array[ExtResource("6")]([SubResource("ClearObjective"), SubResource("ProtectObjective")])
completion = SubResource("Completion")
