[gd_resource type="Resource" script_class="EncounterDefinition" format=3 uid="uid://be8lpv7x5jkkg"]

[ext_resource type="Script" uid="uid://d0ve8acy3o36l" path="res://game/content/encounters/encounter_definition.gd" id="1_encounter"]
[ext_resource type="Script" uid="uid://djdgambkorbaa" path="res://game/content/encounters/encounter_spawn_entry.gd" id="2_spawn"]
[ext_resource type="Script" uid="uid://bo1m3mwr2j2r2" path="res://game/content/encounters/encounter_group_definition.gd" id="3_group"]
[ext_resource type="Script" uid="uid://bm7kwws06w4ph" path="res://game/content/encounters/encounter_wave_definition.gd" id="4_wave"]
[ext_resource type="Script" uid="uid://cavdtginx1582" path="res://game/content/encounters/encounter_warning_definition.gd" id="5_warning"]
[ext_resource type="Script" uid="uid://bkuyjsemgao7e" path="res://game/content/encounters/encounter_objective_definition.gd" id="6_objective"]
[ext_resource type="Script" uid="uid://b4d371ibkdcmy" path="res://game/content/encounters/encounter_completion_contract.gd" id="7_completion"]

[sub_resource type="Resource" id="Completion"]
script = ExtResource("7_completion")
required_objective_ids = PackedStringArray("clear_crypt_skeletons")
gate_action = 1
gate_entity_ids = PackedStringArray("training_exit")

[sub_resource type="Resource" id="ClearObjective"]
script = ExtResource("6_objective")
objective_id = &"clear_crypt_skeletons"
objective_type = 1
description_key = "objective.defeat_crypt_skeletons"
target_id = &"skeleton_chaser_sandbox"
target_count = 5

[sub_resource type="Resource" id="GroupWarning"]
script = ExtResource("5_warning")
warning_id = &"crypt_skeleton_warning"
scope = 2
target_id = &"crypt_patrol_group"
message_key = "encounter.warning.skeleton_patrol"
visible_seconds = 1.25

[sub_resource type="Resource" id="SpawnSkeletons"]
script = ExtResource("2_spawn")
entry_id = &"crypt_skeleton_batch"
enemy_id = &"skeleton_chaser_sandbox"
count = 5
spawn_marker_ids = PackedStringArray("training_skeleton_01", "training_skeleton_02", "training_skeleton_03", "training_skeleton_04", "training_skeleton_05")
formation_id = &"training_loop"
interval_seconds = 0.15
maximum_alive = 5

[sub_resource type="Resource" id="SkeletonGroup"]
script = ExtResource("3_group")
group_id = &"crypt_patrol_group"
spawn_entries = Array[ExtResource("2_spawn")]([SubResource("SpawnSkeletons")])

[sub_resource type="Resource" id="PatrolWave"]
script = ExtResource("4_wave")
wave_id = &"crypt_patrol_wave"
groups = Array[ExtResource("3_group")]([SubResource("SkeletonGroup")])

[resource]
resource_name = "Crypt Skeleton Encounter (Sandbox)"
script = ExtResource("1_encounter")
encounter_id = &"crypt_skeleton_sandbox"
display_name = "Crypt Skeleton Encounter (Sandbox)"
encounter_tags = PackedStringArray("crypt", "skeleton", "sandbox")
development_only = true
authoring_notes = "PLAYABLE SANDBOX RUNTIME CONTRACT. Five authored Training markers feed the live enemy/death objective; campaign_slot stays zero and completion declares no reward or feature grant."
waves = Array[ExtResource("4_wave")]([SubResource("PatrolWave")])
warnings = Array[ExtResource("5_warning")]([SubResource("GroupWarning")])
objectives = Array[ExtResource("6_objective")]([SubResource("ClearObjective")])
completion = SubResource("Completion")
