display_name = "The Crimson Gate"
encounter_tags = PackedStringArray("campaign", "chapter_1", "gate_seal", "named_elite", "crimson_reaper")
authoring_notes = "Production P0 contract: the physical GateSeal runtime records exactly three gate_seal_collected events before spawning one dedicated Crimson Reaper marker. Completion requires both the counted interactions and that exact named enemy death; only then may l9_exit unlock."
waves = Array[ExtResource("4")]([SubResource("Wave")])
