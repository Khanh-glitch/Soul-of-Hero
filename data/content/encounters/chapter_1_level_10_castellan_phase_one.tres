target_count = 1

[sub_resource type="Resource" id="DeathObjective"]
script = ExtResource("5")
objective_id = &"defeat_vampire_castellan"
objective_type = 6
description_key = "objective.defeat_vampire_castellan"
target_id = &"castellan_defeated"
target_count = 1

[sub_resource type="Resource" id="Boss"]
script = ExtResource("2")
entry_id = &"vampire_castellan"
enemy_id = &"vampire_castellan"
spawn_marker_ids = PackedStringArray("l10_vampire_castellan")
