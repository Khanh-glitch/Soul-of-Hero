[sub_resource type="Resource" id="Completion"]
script = ExtResource("6")
required_objective_ids = PackedStringArray("enter_castellan_phase_two", "defeat_vampire_castellan")
gate_action = 1
gate_entity_ids = PackedStringArray("l10_exit")

[sub_resource type="Resource" id="PhaseObjective"]
script = ExtResource("5")
objective_id = &"enter_castellan_phase_two"
objective_type = 6
description_key = "objective.enter_castellan_phase_two"
