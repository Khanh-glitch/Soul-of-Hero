[resource]
script = ExtResource("1")
encounter_id = &"chapter_1_level_10_castellan_phase_one"
display_name = "Vampire Castellan - Continuous Two-Phase Duel"
encounter_tags = PackedStringArray("campaign", "chapter_1", "boss", "two_phase", "vampire_castellan")
authoring_notes = "One dedicated boss marker owns both phases. The 55-percent health event and final death event are separate runtime objectives, so the north gate cannot open from a proxy kill or a skipped transition."
waves = Array[ExtResource("4")]([SubResource("Wave")])
objectives = Array[ExtResource("5")]([SubResource("PhaseObjective"), SubResource("DeathObjective")])
completion = SubResource("Completion")
