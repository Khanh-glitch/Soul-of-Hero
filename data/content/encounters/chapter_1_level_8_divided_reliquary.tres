[resource]
resource_name = "Chapter 1 Level 8 - The Divided Reliquary"
script = ExtResource("1")
encounter_id = &"chapter_1_level_8_divided_reliquary"
display_name = "The Divided Reliquary"
encounter_tags = PackedStringArray("campaign", "chapter_1", "exclusive_branch", "triple_elite", "elite_chest")
authoring_notes = "Both branches retain exact authored markers, but the dedicated runtime defers all nine and materializes only the physically selected set. It removes the unselected records from live totals, applies one deterministic explicit-axis Elite, and commits elite_chest_claimed only from the real chest opened signal."
waves = Array[ExtResource("4")]([SubResource("Wave")])
objectives = Array[ExtResource("5")]([SubResource("Objective")])
completion = SubResource("Completion")
