{
  "$id": "soh://world/slice_test_vectors.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "fixture_scope": {
      "type": "string"
    },
    "native_playable": {
      "const": false
    },
    "schema": {
      "const": "soh.world.slice_test_vectors.v1"
    },
    "vectors": {
      "items": {
        "properties": {
          "assertions": {
            "minItems": 1,
            "type": "array"
          },
          "steps": {
            "minItems": 1,
            "type": "array"
          },
          "vector_id": {
            "pattern": "^VS-[0-9]{2}$",
            "type": "string"
          }
        },
        "required": [
          "vector_id",
          "title",
          "required",
          "steps",
          "assertions"
        ],
        "type": "object"
      },
      "minItems": 7,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "native_playable",
    "fixture_scope",
    "vectors"
  ],
  "title": "slice_test_vectors",
  "type": "object"
}
