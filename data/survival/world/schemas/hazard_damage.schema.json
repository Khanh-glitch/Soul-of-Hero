        "type": "object"
      },
      "type": "array"
    },
    "native_playable": {
      "const": false
    },
    "novice_safe_route": {
      "required": [
        "route_id",
        "max_authored_hazard_tiles"
      ],
      "type": "object"
    },
    "schema": {
      "const": "soh.world.hazard_damage.v1"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "native_playable",
    "hazards",
    "novice_safe_route",
    "hazardous_shortcut"
