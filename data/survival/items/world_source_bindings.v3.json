  "reward_policy": {
    "roadside_cache": "DETERMINISTIC_CANONICAL_A1_QUANTITIES",
    "core_probability": "NONE; no Core is added to this binding and no first-Core probability is invented",
    "abundance": "Canonical cache unchanged: 3 iron_scrap + 2 knowledge_spares per 1800 active seconds. Notes crate 01 unchanged: 1 research_notes per 1800 active seconds. A1 crates 02/03 are ONE-TIME early salvage (3 scrap + 2 spares; 2 oak + 1 note) and never replenish; no Core/Gold and no renewable abundance inflation.",
    "partial_failure": "REJECT_WHOLE_CLAIM; if the bag cannot hold every reward, no item, cooldown, generation or receipt is committed",
    "no_gold_value": "iron_scrap feeds relay/furnace/tools; knowledge_spares feed research_kit/make_spares/research; oak_wood feeds relay/charcoal/station kits. A no-Core, no-Gold trip still advances power, production and knowledge.",
    "roadside_notes": "A3 gate approval of existing road_notes proposal (1 research_notes / 1800 active seconds) on exactly one A1 physical crate si:r_ashen_crown:roadside_supply:01. It replaces the legacy soul_ember->make_notes bootstrap for ordinary tool research; it does not add scrap/spares abundance or any Core.",
    "basic_tool_research": "iron_pick targeted research is explicitly priced at 3 knowledge_spares + 1 research_notes (recipe.research_cost). Default targeted research remains 6 spares + 2 notes. This separates basic tool learning from advanced/Core research without changing canonical source rates."
  },
