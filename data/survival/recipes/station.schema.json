{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stations",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "soh.economy.stations.v1"
    },
    "stations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "kind",
          "tier",
          "capabilities",
          "queue_capacity",
          "footprint",
          "tile_size",
          "placement_owner",
          "powered"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "queue_capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "footprint": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "tile_size": {
            "const": 16
          },
          "placement_owner": {
            "const": "A0"
          },
          "powered": {
            "type": "boolean"
          },
          "kit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "upgrade_cost": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "status": {
      "type": "string"
    }
  }
}
