{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources",
    "world_contract_status",
    "live_harvest_authority",
    "note"
  ],
  "properties": {
    "schema": {
      "const": "soh.economy.sources.v1"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item_id",
          "acquisition",
          "region_id",
          "yield_per_claim",
          "replenishment_seconds",
          "risk",
          "requirements",
          "integration_status",
          "provenance",
          "balance_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "acquisition": {
            "enum": [
              "harvest",
              "loot",
              "existing_reward"
            ]
          },
          "region_id": {
            "type": "string"
          },
          "poi_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "yield_per_claim": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "replenishment_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "combat"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "tool_item",
                    "tool_tag",
                    "access_tier",
                    "power",
                    "resistance"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              }
            }
          },
          "integration_status": {
            "enum": [
              "LIVE_SURV_010",
              "LIVE_EXISTING_REWARDS",
              "PROPOSED_A1"
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(SYS|DEP|JOURNEY|POI)-[0-9]{2}$"
            }
          },
          "balance_status": {
            "const": "SOH_PROPOSAL"
          }
        }
      }
    },
    "world_contract_status": {
      "type": "string"
    },
    "live_harvest_authority": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
