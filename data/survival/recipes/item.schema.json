{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "soh.economy.items.v1"
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_status",
        "balance_status",
        "id",
        "kind",
        "label",
        "provenance",
        "source_ids",
        "stack_limit",
        "storage",
        "tags",
        "tier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "material",
            "consumable",
            "blueprint",
            "skill_core",
            "equipment",
            "station_kit",
            "key_item"
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage": {
          "enum": [
            "stack",
            "instance"
          ]
        },
        "stack_limit": {
          "enum": [
            1,
            50
          ]
        },
        "balance_status": {
          "const": "SOH_PROPOSAL"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(SYS|DEP|JOURNEY|POI)-[0-9]{2}$"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "acquisition_status": {
          "enum": [
            "LIVE",
            "PROPOSED_WORLD",
            "CRAFT_ONLY"
          ]
        },
        "salvage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outputs",
            "station",
            "min_tier"
          ],
          "properties": {
            "outputs": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "station": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "min_tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "max_uses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_condition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "abstract_skill_id": {
          "type": "string"
        },
        "skill_readiness": {
          "const": "BLOCKED_PENDING_A4"
        },
        "repair_policy": {
          "enum": [
            "material_repair",
            "reconstruct_only"
          ]
        },
        "slot": {
          "enum": [
            "face",
            "body",
            "tool"
          ]
        },
        "resistances": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "unlocks_recipe": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "purpose": {
          "type": "string"
        },
        "legacy": {
          "type": "boolean"
        }
      }
    }
  }
}
