[node name="Game" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.73, 0.38, 1)
theme_override_font_sizes/font_size = 15
text = "SOUL OF HERO"

[node name="Build" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
text = "Nền tảng alpha chơi được • Godot 4.7 • Lưu cục bộ • Desktop/Android ngang"

[node name="ArtHeader" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.62, 0.9, 1)
text = "GHI CÔNG TÀI NGUYÊN"

[node name="Art" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
text = "• Cainos Pixel Art Top Down — nền, kiến trúc, cây và đạo cụ Home Map.\n• 0x72 Dungeon Tileset II — bản đồ hầm ngục.\n• Shikashi Fantasy Icons và Free Inventory UI — icon, HUD và khung pixel.\n• Complete UI Book Styles / TravelBookLite — Crusenho Agus Hennihuno; Field Codex, XP và continuation UI.\n• RPG Arsenal v1.1 — LimeZu; icon vũ khí, trang bị và loot.\n• Handjet, Grenze Gotisch, VT323 — SIL Open Font License 1.1.\n• Kenney Input Prompts Pixel, RPG Audio, Impact Sounds — CC0.\n• RPG Essentials SFX Free — Leohpaz; VFX Free Pack — CodeManu.\n• Super Pixel Effects Gigapack Free — Will Tice / unTied Games.\n• Pixel_Poem Enemy Animations Set và FreeKnight — sprite nhân vật.\n• Chapter I key art và biểu trưng Soul — hình ảnh gốc của dự án tạo bằng OpenAI ImageGen."
autowrap_mode = 2

[node name="NoticeHeader" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.62, 0.9, 1)
text = "PHẠM VI BẢN HIỆN TẠI"

[node name="Notice" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
text = "Chiến dịch Chapter 1 hiện có 10 màn hoàn chỉnh trên khung 100 level. Level 11–100, Săn Quái, Thử Thách, Vực Sâu, Lò Rèn và các mode endgame vẫn là nội dung dự kiến; UI không được xem là bằng chứng các mode đó đã playable."
autowrap_mode = 2

[node name="Future" type="Label" parent="Margin/Layout/Card/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.53, 0.49, 0.57, 1)
text = "TÍNH NĂNG DỰ KIẾN: Hero bổ sung, Chương 3, trang phục, chia sẻ đội Soul và xếp hạng trực tuyến nằm ngoài phạm vi bản alpha này."
autowrap_mode = 2
