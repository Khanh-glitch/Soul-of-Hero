[node name="CreditsButton" type="Button" parent="HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 25)
layout_mode = 2
text = "GHI CÔNG"

[node name="NewProfileButton" type="Button" parent="HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(132, 25)
layout_mode = 2
text = "HỒ SƠ MỚI"

[node name="SettingsPanel" parent="." instance=ExtResource("1_settings")]
layout_mode = 2
size_flags_vertical = 3

[node name="ResetConfirmation" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "TẠO HỒ SƠ MỚI?"
dialog_text = "Tiến trình chiến dịch, đội Soul và phần thưởng sẽ được đặt lại. Các cài đặt hiện tại được giữ nguyên."
ok_button_text = "ĐẶT LẠI TIẾN TRÌNH"
cancel_button_text = "HỦY"
