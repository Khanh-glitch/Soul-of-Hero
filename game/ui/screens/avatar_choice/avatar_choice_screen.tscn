; New Game's identity step.
;
; Layout budget, in the 640x360 layout units the whole UI is authored in (the window
; stretches to 720p/1440p/2160p by whole multiples):
;   12 margin + 11 kicker + 30 headline + 186 cards + 12 status + 24 footer + 4*6 separation
;   = 299 of the 324 usable units. The previous revision spent 400+ and clipped the
; headline off the top of a 720p window while the NAM/NU captions fell below the
; bottom edge; that is why every band here has an explicit size.

[node name="AvatarChoiceScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="DungeonBackdrop" parent="." instance=ExtResource("3_backdrop")]
layout_mode = 1

[node name="Vignette" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.05, 0.04, 0.03, 0.4)

[node name="SafeMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
