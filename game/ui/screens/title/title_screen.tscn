theme_override_colors/font_color = Color(0.94, 0.89, 0.78, 1)
text = "Sống qua mỗi màn đêm"

[node name="Build" type="Label" parent="SafeMargin/MainRow/Brand"]
layout_mode = 2
theme_type_variation = &"A6Caption"
