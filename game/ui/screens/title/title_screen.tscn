[gd_scene load_steps=10 format=3]

[ext_resource type="Theme" path="res://game/ui/theme/a6_survival_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://game/ui/screens/title/title_screen.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://game/ui/theme/dungeon_backdrop.tscn" id="3_backdrop"]
[ext_resource type="Texture2D" path="res://assets/branding/chapter_1_key_art_imagen.png" id="5_key_art"]
[ext_resource type="Texture2D" path="res://assets/branding/soul_hero_emblem_imagen.png" id="6_emblem"]
[ext_resource type="Texture2D" path="res://assets/library/downloaded/complete_ui_book_styles_free/01_TravelBookLite/Sprites/UI_TravelBook_IconPlay01a.png" id="9_continue_icon"]
[ext_resource type="Texture2D" path="res://assets/library/downloaded/complete_ui_book_styles_free/01_TravelBookLite/Sprites/UI_TravelBook_IconRestart01a.png" id="10_new_game_icon"]
[ext_resource type="Texture2D" path="res://assets/a6_ui/panels/panel.png" id="11_plate"]
[ext_resource type="Texture2D" path="res://assets/a6_ui/icons/time_dawn.png" id="8_dawn"]

; The title is the first promise the game makes. It used to sell a hero-switching
; action game ("awaken your Soul, switch heroes, hold the rhythm"); the game that
; follows is a fourteen-day survival run, so the promise was rewritten to match it.
; The Knight silhouette is gone for the same reason: the player is not that knight.

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="DungeonBackdrop" parent="." instance=ExtResource("3_backdrop")]
layout_mode = 1

[node name="ChapterKeyArt" type="TextureRect" parent="."]
modulate = Color(0.9, 0.86, 0.8, 0.85)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("5_key_art")
expand_mode = 1
stretch_mode = 6

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.06, 0.04, 0.03, 0.55)

[node name="SafeMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainRow" type="HBoxContainer" parent="SafeMargin"]
layout_mode = 2
theme_override_constants/separation = 30

[node name="Brand" type="VBoxContainer" parent="SafeMargin/MainRow"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 5

[node name="Emblem" type="TextureRect" parent="SafeMargin/MainRow/Brand"]
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("6_emblem")
expand_mode = 1
stretch_mode = 5

[node name="TitlePlate" type="NinePatchRect" parent="SafeMargin/MainRow/Brand"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("11_plate")
patch_margin_left = 6
patch_margin_top = 5
patch_margin_right = 6
patch_margin_bottom = 7
texture_filter = 1

[node name="Title" type="Label" parent="SafeMargin/MainRow/Brand/TitlePlate"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 6.0
offset_right = -12.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"A6Title"
theme_override_colors/font_color = Color(0.25, 0.13, 0.08, 1)
theme_override_colors/font_shadow_color = Color(0.85, 0.7, 0.45, 0.35)
theme_override_font_sizes/font_size = 32
text = "SOUL OF
HERO"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Tagline" type="Label" parent="SafeMargin/MainRow/Brand"]
layout_mode = 2
theme_type_variation = &"A6Body"
theme_override_colors/font_color = Color(0.94, 0.89, 0.78, 1)
text = "Mười bốn ngày. Một vùng đất lạnh.
Dựng chỗ trú trước khi trời tối."

[node name="Promises" type="HBoxContainer" parent="SafeMargin/MainRow/Brand"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="DawnRow" type="HBoxContainer" parent="SafeMargin/MainRow/Brand/Promises"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="DawnIcon" type="TextureRect" parent="SafeMargin/MainRow/Brand/Promises/DawnRow"]
