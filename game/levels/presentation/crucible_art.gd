class_name CrucibleArt
extends Node2D

## Blood Crucible environment presentation (Chapter 1, Level 5).
##
## The authored architecture is a document: data/levels/chapter_1_level_5_architecture.json
## (generated by tools/level5/architecture.py, validated so it can never invent
## walkable or solid ground). This node draws that document over the live level:
##
##   Bedrock      -12   unexcavated rock behind and between rooms, so a room
##                      reads as carved out of a mountain instead of floating in
##                      a black background
##   FloorDetail   -9   authored paving on every walkable cell, with the
##                      processional walk, blood channels, grates and stains the
##                      composition calls for painted over it
##   WallStack      2   five-course walls: socle, field, dado, cornice and cap,
##                      extruded upward into the rock above each wall band. It
##                      sits above the level's collision tiles (Geometry, z 0)
##                      and below the entity root (z 3), so it replaces the
##                      stock grey brick instead of hiding behind it
##   Props          -   whole-sprite architecture and furniture, added to the
##                      level's own y-sorted entity root so the Knight, enemies
##                      and props sort against each other correctly
##   Lights         1   designed illumination: a few strong local sources around
##                      the set pieces, with the ambient dropped so they read
##
## Nothing here has collision. Solid architecture only ever appears on cells the
## level already marks solid, and the validator in architecture.py enforces it.
##
## Entry point: CrucibleArt.attach(level) — idempotent, rebuilds on map reload.

const TILE_ART := "res://assets/environment/chapter1/crucible/crucible_tiles.png"
const TILE_INDEX := "res://assets/environment/chapter1/crucible/crucible_tiles.json"
const PROP_ART := "res://assets/environment/chapter1/crucible/crucible_props.png"
const PROP_INDEX := "res://assets/environment/chapter1/crucible/crucible_props.json"
const LIGHT_ART := "res://assets/environment/chapter1/crucible/light_radial.png"

const NODE_NAME := "CrucibleArt"
const BEDROCK := "CrucibleBedrock"
const SHADOWS := "CrucibleShadow"
const FLOOR_DETAIL := "CrucibleFloor"
const WALL_STACK := "CrucibleWalls"
const PROP_ROOT := "CrucibleProps"
const LIGHT_ROOT := "CrucibleLights"

const TILE := 16
## How far past the authored cells the rock fill reaches, so the map's own
## edges are surrounded by stone rather than ending in a straight black line.
const BEDROCK_MARGIN := 6
## How many courses of wall are built above a wall band when there is rock above
## it. Three is what makes a wall read as a storey rather than as a kerb.
const WALL_EXTRUDE := 3
## The authored wall stack has to draw over the level's own collision tiles
## (Geometry, z 0) or the grey brick tileset covers the architecture built on
## top of it, and under the entity root (z 3) so the Knight still walks in front.
const WALL_Z := 2
const FLOOR_Z := -9
const BEDROCK_Z := -12
const SHADOW_Z := -8

## Ambient the authored lighting is composed against. Dark enough for the lit
## set pieces to be the brightest thing in frame, bright enough that the floor,
## the enemies and the player are all readable during combat.
const AMBIENT := Color(0.30, 0.32, 0.40, 1.0)
const BACKGROUND := Color(0.035, 0.028, 0.032, 1.0)

var level_data_path := ""
var document: Dictionary = {}
var _wall_frames := {}
var _tile_frames := {}
var _prop_frames := {}
var _tile_texture: Texture2D
var _prop_texture: Texture2D

var stats := {}


static func doc_for(level_path: String) -> String:
	var base := level_path.get_file().get_basename()
	return "res://data/levels/%s_architecture.json" % base


static func has_document(level_path: String) -> bool:
	return not level_path.is_empty() and FileAccess.file_exists(doc_for(level_path))


## Attach, or rebuild, the authored environment for a level. Safe to call after
## every map reload: children from the previous build are freed first.
static func attach(level: Node) -> CrucibleArt:
	if level == null or not level.has_method("get_level_snapshot"):
		return null
	if bool(Engine.get_meta(&"crucible_art_disabled", false)):
		return null
	var path := String(level.get("level_data_path"))
	if not has_document(path):
		return null
	var existing := level.get_node_or_null(NodePath(NODE_NAME)) as CrucibleArt
	if existing == null:
		existing = CrucibleArt.new()
		existing.name = NODE_NAME
		existing.level_data_path = path
		level.add_child(existing)
	existing.level_data_path = path
	existing.rebuild()
	return existing


func rebuild() -> void:
	_clear()
	document = _read_json(doc_for(level_data_path))
	if document.is_empty():
		push_warning("CrucibleArt: architecture document missing for %s" % level_data_path)
		return
	_tile_frames = _frame_table(TILE_INDEX)
	_prop_frames = _frame_table(PROP_INDEX)
	_tile_texture = load(TILE_ART)
	_prop_texture = load(PROP_ART)
	_apply_lighting()
	var floor := _cells("Backdrop")
	var geometry := _cells("Geometry")
	_build_bedrock(floor, geometry)
	_build_floor_detail(floor, geometry)
	_build_shadows(floor, geometry)
	_build_walls(floor, geometry)
	_build_props(geometry)
	_build_lights()
	print("CRUCIBLE ART: floor_detail=%d wall_cells=%d bedrock=%d props=%d lights=%d shadows=%d"
		% [
			int(stats.get("floor", 0)), int(stats.get("walls", 0)),
			int(stats.get("bedrock", 0)), int(stats.get("props", 0)),
			int(stats.get("lights", 0)), int(stats.get("shadows", 0)),
		])


func _clear() -> void:
	for child: Node in get_children():
		remove_child(child)
		child.queue_free()
	# props live in the level's y-sorted entity root, so they must be cleared there
	for parent: Node in [get_parent(), _entity_root()]:
		if parent == null:
			continue
		for child: Node in parent.get_children():
			if child.name.begins_with(PROP_ROOT):
				parent.remove_child(child)
				child.queue_free()
			elif parent != get_parent() and child.has_meta(&"crucible_prop"):
				parent.remove_child(child)
				child.queue_free()
	stats = {}


# -- data --------------------------------------------------------------------
func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return {}
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	return parsed if parsed is Dictionary else {}


func _frame_table(path: String) -> Dictionary:
	var raw := _read_json(path)
	return raw.get("frames", {}) as Dictionary


func _cells(layer: String) -> Dictionary:
	var level := get_parent()
	var out := {}
	if level == null or not level.has_method("get_level_snapshot"):
		return out
	var data: Variant = level.get("level_data")
	if not data is Dictionary:
		return out
	var layers: Dictionary = (data as Dictionary).get("layers", {})
	var entries: Variant = layers.get(layer, [])
	if not entries is Array:
		return out
	for raw: Variant in entries:
		if raw is Dictionary and (raw as Dictionary).has("x"):
			out[Vector2i(int((raw as Dictionary)["x"]), int((raw as Dictionary)["y"]))] = true
	return out


func _entity_root() -> Node2D:
	var level := get_parent()
	if level == null:
		return null
	return level.get_node_or_null("Entities") as Node2D


# -- tileset -----------------------------------------------------------------
func _tileset() -> TileSet:
	var tile_set := TileSet.new()
	tile_set.tile_size = Vector2i(TILE, TILE)
	var source := TileSetAtlasSource.new()
	source.texture = _tile_texture
	source.texture_region_size = Vector2i(TILE, TILE)
	var columns := int(_tile_texture.get_width() / TILE)
	var rows := int(_tile_texture.get_height() / TILE)
	for y: int in range(rows):
		for x: int in range(columns):
			source.create_tile(Vector2i(x, y))
	tile_set.add_source(source, 0)
	return tile_set


func _layer(node_name: String, z: int, tile_set: TileSet) -> TileMapLayer:
	var layer := TileMapLayer.new()
	layer.name = node_name
	layer.tile_set = tile_set
	layer.z_as_relative = false
	layer.z_index = z
	layer.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	add_child(layer)
	return layer


func _atlas(frame_name: String) -> Vector2i:
	var frame: Variant = _tile_frames.get(frame_name)
	if not frame is Dictionary:
		return Vector2i(-1, -1)
	return Vector2i(int((frame as Dictionary)["x"]) / TILE, int((frame as Dictionary)["y"]) / TILE)


func _put(layer: TileMapLayer, cell: Vector2i, frame_name: String) -> bool:
	var coords := _atlas(frame_name)
	if coords.x < 0:
		return false
	layer.set_cell(cell, 0, coords)
	return true


# -- bedrock -----------------------------------------------------------------
## Fill the rock around and between the rooms.
##
## Without this every room is a lit box floating on black, and the black areas
## inside the map read as holes in the renderer rather than as the mountain the
## complex was cut into. The first version only reached seven cells out from the
## authored cells, which left large black voids in the middle of the frame; the
## fill now covers the whole map rectangle, so a room is always surrounded by
## stone and the eye reads excavation rather than emptiness.
func _build_bedrock(floor: Dictionary, geometry: Dictionary) -> void:
	var tile_set := _tileset()
	var layer := _layer(BEDROCK, BEDROCK_Z, tile_set)
	var content := {}
	for cell: Vector2i in floor:
		content[cell] = true
	for cell: Vector2i in geometry:
		content[cell] = true
	if content.is_empty():
		return
	var min_x := 1 << 30
	var min_y := 1 << 30
	var max_x := -(1 << 30)
	var max_y := -(1 << 30)
	for cell: Vector2i in content:
		min_x = mini(min_x, cell.x)
		min_y = mini(min_y, cell.y)
		max_x = maxi(max_x, cell.x)
		max_y = maxi(max_y, cell.y)
	var painted := 0
	for y: int in range(min_y - BEDROCK_MARGIN, max_y + BEDROCK_MARGIN + 1):
		for x: int in range(min_x - BEDROCK_MARGIN, max_x + BEDROCK_MARGIN + 1):
			var cell := Vector2i(x, y)
			if content.has(cell):
				continue
			var frame := "bedrock_a" if posmod(cell.x * 7 + cell.y * 13, 3) else "bedrock_b"
			if _put(layer, cell, frame):
				painted += 1
	layer.update_internals()
	stats["bedrock"] = painted


# -- floor -------------------------------------------------------------------
## Every walkable cell gets authored paving, not just the cells the composition
## singles out: leaving the map's own grey stone showing through would put two
## different materials in one room and undo the material read. The document's
## floor entries then override the default flag with the processional walk, the
## blood channels, the grates and the stains.
func _build_floor_detail(floor: Dictionary, geometry: Dictionary) -> void:
	var layer := _layer(FLOOR_DETAIL, FLOOR_Z, _tileset())
	var painted := 0
	for cell: Vector2i in floor:
		if geometry.has(cell):
			continue
		if _put(layer, cell, _default_floor(cell)):
			painted += 1
	var overrides := 0
	for raw: Variant in document.get("layers", {}).get("floor", []):
		if not raw is Dictionary:
			continue
		var entry: Dictionary = raw
		var cell_raw: Variant = entry.get("cell", [])
		if not cell_raw is Array or (cell_raw as Array).size() < 2:
			continue
		var cell := Vector2i(int((cell_raw as Array)[0]), int((cell_raw as Array)[1]))
		# never paint over solid ground: the floor layer is walkable by definition
		if not floor.has(cell) or geometry.has(cell):
			continue
		if _put(layer, cell, String(entry.get("frame", ""))):
			painted += 1
			overrides += 1
	layer.update_internals()
	stats["floor"] = painted
	stats["floor_overrides"] = overrides


## Deterministic flagstone variation. The four plain floor frames are the four
## quadrants of one 32 px flag, so parity picks the quadrant and the paving reads
## as large stone rather than as a 16 px grid. The same cell always gets the same
## stone, so a rebuild is byte-identical and a reload never shimmers.
func _default_floor(cell: Vector2i) -> String:
	var quad := (1 if cell.x % 2 else 0) + (2 if cell.y % 2 else 0)
	var roll := posmod(cell.x * 31 + cell.y * 17, 23)
	if roll == 0:
		return "floor_worn"
	if roll == 9:
		return "floor_broken"
	return ["floor_a", "floor_b", "floor_c", "floor_d"][quad]


# -- shadows -----------------------------------------------------------------
## Ambient occlusion at the foot of every wall face, painted on its own layer so
## it darkens the paving without touching it. The floor and the wall are otherwise
## two flat planes meeting on a hard line.
func _build_shadows(floor: Dictionary, geometry: Dictionary) -> void:
	var layer := _layer(SHADOWS, SHADOW_Z, _tileset())
	var painted := 0
	for cell: Vector2i in geometry:
		var below := Vector2i(cell.x, cell.y + 1)
		if not floor.has(below) or geometry.has(below):
			continue
		if _put(layer, below, "shadow_edge"):
			painted += 1
	layer.update_internals()
	stats["shadows"] = painted


# -- walls -------------------------------------------------------------------
## Five-course wall stacks: a socle where the wall meets the floor, a cours of
## field above it, a carved dado band, then a projecting cornice and a lit cap.
## The stack is extruded upward into the surrounding rock, so a wall has height
## instead of being a two-tile kerb.
func _build_walls(floor: Dictionary, geometry: Dictionary) -> void:
	var layer := _layer(WALL_STACK, WALL_Z, _tileset())
	var overlays: Dictionary = {}
	for raw: Variant in document.get("layers", {}).get("wall", []):
		if raw is Dictionary:
			var cell_raw: Variant = (raw as Dictionary).get("cell", [])
			if cell_raw is Array and (cell_raw as Array).size() >= 2:
				overlays[Vector2i(int((cell_raw as Array)[0]), int((cell_raw as Array)[1]))] = String(
					(raw as Dictionary).get("frame", ""))

	var faces: Array[Vector2i] = []
	for cell: Vector2i in geometry:
		if floor.has(Vector2i(cell.x, cell.y + 1)):
			faces.append(cell)
	faces.sort_custom(func(a: Vector2i, b: Vector2i) -> bool:
		if a.y == b.y:
			return a.x < b.x
		return a.y < b.y)

	var painted := 0
	for face: Vector2i in faces:
		# climb the wall band to its topmost course
		var top := face.y
		while geometry.has(Vector2i(face.x, top - 1)):
			top -= 1
		# 1. the band itself: bottom course is the socle
		for row: int in range(top, face.y + 1):
			var cell := Vector2i(face.x, row)
			var frame := String(overlays.get(cell, ""))
			if frame.is_empty():
				var depth := face.y - row
				if depth == 0:
					frame = "wall_plinth"
				elif depth == 1:
					frame = "wall_dado_a" if posmod(face.x, 6) == 0 else "wall_field_a"
				else:
					frame = "wall_field_b"
			if _put(layer, cell, frame):
				painted += 1
		# 2. extrude upward into rock only: never over walkable ground or over
		#    another room's floor
		var highest := top - 1
		for step: int in range(1, WALL_EXTRUDE + 1):
			var cell := Vector2i(face.x, top - step)
			if floor.has(cell) or geometry.has(cell):
				break
			var frame_name := "wall_field_a"
			if posmod(face.x, 4) == 0:
				frame_name = "wall_pier"
			elif posmod(face.x, 4) == 0:
				frame_name = "wall_field_b"
			if not _put(layer, cell, frame_name):
				break
			painted += 1
			highest = cell.y
		# 3. cornice and cap above the highest course
		var cornice := Vector2i(face.x, highest - 1)
		if not floor.has(cornice) and not geometry.has(cornice):
			if _put(layer, cornice, "wall_cornice"):
				painted += 1
			var cap := Vector2i(face.x, highest - 2)
			if not floor.has(cap) and not geometry.has(cap):
				if _put(layer, cap, "wall_cap"):
					painted += 1
	# 4. every solid cell the wall pass did not cover is the interior of the
	#    masonry: paint it as unexcavated rock so no stock grey brick shows through
	for cell: Vector2i in geometry:
		if layer.get_cell_source_id(cell) != -1:
			continue
		var rock := "bedrock_a" if posmod(cell.x * 7 + cell.y * 13, 3) else "bedrock_b"
		if _put(layer, cell, rock):
			painted += 1
	layer.update_internals()
	stats["walls"] = painted


# -- props -------------------------------------------------------------------
func _build_props(geometry: Dictionary) -> void:
	var root := _entity_root()
	if root == null:
		root = Node2D.new()
		root.name = PROP_ROOT
		root.z_as_relative = false
		root.z_index = 0
		add_child(root)
	var placed := 0
	for raw: Variant in document.get("props", []):
		if not raw is Dictionary:
			continue
		var entry: Dictionary = raw
		var frame_data: Variant = _prop_frames.get(String(entry.get("frame", "")))
		if not frame_data is Dictionary:
			continue
		var spec: Dictionary = frame_data
		var width := float(int(spec["w"]))
		var height := float(int(spec["h"]))
		var cell_raw: Variant = entry.get("cell", [])
		if not cell_raw is Array or (cell_raw as Array).size() < 2:
			continue
		var cell := Vector2i(int((cell_raw as Array)[0]), int((cell_raw as Array)[1]))

		var sprite := Sprite2D.new()
		var atlas := AtlasTexture.new()
		atlas.atlas = _prop_texture
		atlas.region = Rect2(float(int(spec["x"])), float(int(spec["y"])), width, height)
		sprite.texture = atlas
		sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		sprite.centered = true
		sprite.set_meta(&"crucible_prop", true)
		sprite.name = "Prop_%s_%d_%d" % [String(entry.get("frame", "prop")), cell.x, cell.y]
		if bool(entry.get("y_sort", true)):
			# base-anchored: the sprite's feet sit on the bottom of its cell, and
			# the y-sorted root then sorts it against the Knight and the enemies
			sprite.position = Vector2(cell.x * TILE + TILE * 0.5, cell.y * TILE + TILE)
			sprite.offset = Vector2(0.0, -height * 0.5)
		else:
			sprite.position = Vector2(cell.x * TILE + TILE * 0.5, cell.y * TILE + TILE * 0.5)
			sprite.offset = Vector2(0.0, -height * 0.5)
			sprite.z_index = 0
		if bool(entry.get("flip", false)):
			sprite.flip_h = true
		root.add_child(sprite)
		placed += 1
	stats["props"] = placed


# -- lights ------------------------------------------------------------------
func _build_lights() -> void:
	var textures := load(LIGHT_ART) as Texture2D
	var holder := Node2D.new()
	holder.name = LIGHT_ROOT
	holder.z_as_relative = false
	holder.z_index = WALL_Z + 1
	add_child(holder)
	var count := 0
	for raw: Variant in document.get("lights", []):
		if not raw is Dictionary:
			continue
		var entry: Dictionary = raw
		var light := PointLight2D.new()
		light.texture = textures
		light.position = Vector2(float(entry.get("x", 0)), float(entry.get("y", 0)))
		var colour: Variant = entry.get("color", [1.0, 0.7, 0.4])
		if colour is Array and (colour as Array).size() >= 3:
			light.color = Color(float((colour as Array)[0]), float((colour as Array)[1]),
				float((colour as Array)[2]), 1.0)
		light.energy = float(entry.get("energy", 1.0))
		light.texture_scale = float(entry.get("scale", 3.0))
		light.shadow_enabled = false
		light.range_z_min = -64
		light.range_z_max = 64
		holder.add_child(light)
		count += 1
	stats["lights"] = count


func _apply_lighting() -> void:
	var level := get_parent()
	if level == null:
		return
	var host := level.get_parent()
	if host != null:
		var world_tint := host.get_node_or_null("WorldTint") as CanvasModulate
		if world_tint != null:
			world_tint.color = AMBIENT
		var background := host.get_node_or_null("Background/Color") as Polygon2D
		if background != null:
			background.color = BACKGROUND
	# the authored art carries its own material colours; the level's own tints are
	# left neutral so the two do not multiply into mud. DungeonLevel applies its
	# exported tints once in _ready(), so the live layers have to be repainted too
	# or the old palette keeps darkening whatever the authored layer leaves visible.
	for property: String in ["backdrop_tint", "geometry_tint", "decor_tint"]:
		level.set(property, Color(1.0, 1.0, 1.0, 1.0))
		var layer := level.get_node_or_null(property.replace("_tint", "").capitalize()) as CanvasItem
		if layer != null:
			layer.modulate = Color(1.0, 1.0, 1.0, 1.0)
	# The level's own Decor layer is the stock tileset's idea of dressing: loose
	# crates, brackets and rugs in the old blue-grey palette. With authored props
	# in place they read as debris dropped on the new floor, so the authored pass
	# takes over that role entirely. Decor carries no collision.
	var decor := level.get_node_or_null("Decor") as CanvasItem
	if decor != null:
		decor.visible = false
