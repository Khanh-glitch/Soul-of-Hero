weapon_tags = PackedStringArray("wizard", "staff", "magic", "dark", "crowd_control", "teleport")
hand_ui_description = "RMB selects a target; LMB/J sends Wandering Shade; E casts Dark Passage toward that target."
spirit_ui_description = "While Reserve, confirmed kills become Dark Soul icons. Dash to anchor, kill again, then Dash back to summon Wizard."
