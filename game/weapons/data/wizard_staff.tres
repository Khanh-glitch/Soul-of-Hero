damage_tags = PackedStringArray("wizard", "soul", "summon", "dash")

[resource]
resource_name = "Wizard Staff"
script = ExtResource("1_definition")
weapon_id = &"wizard_staff"
display_name = "Wizard Staff"
short_description = "A dark-control Hand form: weak Shade setup, density-scaled passage burst, and a kill-powered Reserve Soul loop."
unlock_feature = &"wizard_staff"
unlock_condition = "Collect 50 Wizard shards and unlock the Wizard Hero; the boss grants 10 shards, never an item."
unlock_campaign_level = 20
normal_attack = SubResource("Attack")
hand_skill = SubResource("Skill")
spirit_trigger = SubResource("Trigger")
spirit_action = SubResource("Action")
hand_animation_library = &"wizard_hero_form"
spirit_animation_library = &"wizard_soul_form"
monster_part_compatibility_tags = PackedStringArray("wizard", "magic", "dark", "area")
