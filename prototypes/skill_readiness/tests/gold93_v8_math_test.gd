extends SceneTree

## Bit-exact check of native/venom/v8_math.gd against V8 (Node) reference
## vectors in tests/data/v8_math_vectors.json (generated by
## tools/oracle/gen_v8_math_vectors.js).
##
## Every comparison is on IEEE-754 bit patterns, so a 1-ulp difference is a
## failure. `pow_general` is the one function that is not yet exact; its
## mismatches are reported as KNOWN_RESIDUAL and do not fail the test, and
## the verdict line says so explicitly.

const V8 = preload("res://prototypes/skill_readiness/native/venom/v8_math.gd")
const VECTORS := "res://prototypes/skill_readiness/tests/data/v8_math_vectors.json"
const KNOWN_RESIDUAL := ["pow_general"]
const MAX_PRINTED := 3


func _init() -> void:
	_diag()
	var text := FileAccess.get_file_as_string(VECTORS)
	if text == "":
		print("GOLD93_V8_MATH: FAIL / vectors missing")
		quit(1)
		return
	var data = JSON.parse_string(text)
	if not (data is Dictionary):
		print("GOLD93_V8_MATH: FAIL / vectors unreadable")
		quit(1)
		return
	var fns: Dictionary = data["fns"]
	var hard_fail := false
	var report: Array = []
	for name in ["sin", "cos", "atan2", "hypot", "asin", "exp", "log", "pow_exp2", "pow_general"]:
		var block: Dictionary = fns[name]
		var rows: Array = block["rows"]
		var bad := 0
		var shown := 0
		for row in rows:
			var got := _eval(name, row)
			var want := _from_hex(row[row.size() - 1])
			if _bits(got) != _bits(want):
				bad += 1
				if shown < MAX_PRINTED:
					shown += 1
					print("  %s mismatch in=%s want=%s got=%s" % [name, str(row), _bits(want), _bits(got)])
		var kind := "PASS" if bad == 0 else ("KNOWN_RESIDUAL" if name in KNOWN_RESIDUAL else "FAIL")
		if bad > 0 and not (name in KNOWN_RESIDUAL):
			hard_fail = true
		report.append("%s:%s(%d/%d)" % [name, kind, bad, rows.size()])
		print("GOLD93_V8_MATH_FN %s %s mismatches=%d of %d" % [name, kind, bad, rows.size()])
	print("GOLD93_V8_MATH: " + ("FAIL" if hard_fail else "PASS") + " " + " ".join(report))
	quit(1 if hard_fail else 0)


func _eval(name: String, row: Array) -> float:
	match name:
		"sin":
			return V8.v8_sin(_from_hex(row[0]))
		"cos":
			return V8.v8_cos(_from_hex(row[0]))
		"asin":
			return V8.v8_asin(_from_hex(row[0]))
		"exp":
			return V8.v8_exp(_from_hex(row[0]))
		"log":
			return V8.v8_log(_from_hex(row[0]))
		"atan2":
			return V8.v8_atan2(_from_hex(row[0]), _from_hex(row[1]))
		"hypot":
			return V8.v8_hypot(_from_hex(row[0]), _from_hex(row[1]))
		"pow_exp2":
			return V8.v8_pow(_from_hex(row[0]), 2.0)
		"pow_general":
			return V8.v8_pow(_from_hex(row[0]), _from_hex(row[1]))
	return NAN


## Bit pattern of a double as 16 hex digits, high word first (same layout as
## the vectors file).
func _bits(x: float) -> String:
	var b := PackedByteArray()
	b.resize(8)
	b.encode_double(0, x)
	return "%08x%08x" % [b.decode_u32(4), b.decode_u32(0)]


func _from_hex(s: String) -> float:
	var b := PackedByteArray()
	b.resize(8)
	b.encode_u32(4, s.substr(0, 8).hex_to_int())
	b.encode_u32(0, s.substr(8, 8).hex_to_int())
	return b.decode_double(0)


func _bits(v: float) -> String:
	var b := PackedByteArray()
	b.resize(8)
	b.encode_double(0, v)
	return "%08x%08x" % [b.decode_u32(4), b.decode_u32(0)]


## Intermediate values for one sin/cos input that fails bit-exactly.
## Expected (V8 / Python fdlibm): n=-876, y0=3fe4fdd47a949e23,
## y1=3c722adb00000000, sin=3fe384a14729faa7, cos=3fe95bbac4a77853.
func _diag() -> void:
	var x := _from_hex("c0957d7246870000")
	print("DIAG x=", _bits(x), " hi=", "%08x" % V8._hi(x), " s32=", V8._s32(V8._hi(x)))
	var r: Array = V8._rem_pio2(x)
	if r.size() == 3:
		print("DIAG rem n=", r[0], " y0=", _bits(r[1]), " y1=", _bits(r[2]))
		print("DIAG k_sin=", _bits(V8._k_sin(r[1], r[2], 1)), " k_cos=", _bits(V8._k_cos(r[1], r[2])))
	print("DIAG sin=", _bits(V8.v8_sin(x)), " cos=", _bits(V8.v8_cos(x)))
	var q: float = absf(x) * 6.36619772367581382433e-01 + 0.5
	print("DIAG q=", _bits(q), " n=", int(floor(q)))
