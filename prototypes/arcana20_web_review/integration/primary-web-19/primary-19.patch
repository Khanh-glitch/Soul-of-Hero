+/** Presentation-only ARCANA cast seam. No combat, inventory, save or HP writes.
+ * Source output is consumed synchronously; this is an experimental architecture,
+ * not a fidelity/production claim. A game integration must supply its own actual
+ * cast identity, anchors and authoritative simulation timestamp. */
+export type Point={x:number;y:number};
+export interface CastRequest {
+ readonly skillId:string;readonly sourceId:string;readonly castId:string;readonly runId:string;
+ readonly casterId:string;readonly targetId:string|null;readonly caster:Point;readonly target:Point;
+ readonly seed:number;readonly startedAtSimMs:number;
+}
+export interface VisualFrame {readonly sourceTime:number}
+export interface SourcePlayer {readonly durationSeconds:number;sample(seconds:number):VisualFrame|null;dispose():void}
+export type SourceFactory=(request:CastRequest)=>SourcePlayer;
+export class VisualAdapter {
+ private readonly factories=new Map<string,SourceFactory>();
+ private readonly active=new Map<string,{request:CastRequest;player:SourcePlayer;frame:VisualFrame|null}>();
+ register(sourceId:string,factory:SourceFactory){if(this.factories.has(sourceId))throw new Error('duplicate ARCANA source');this.factories.set(sourceId,factory);}
+ start(request:CastRequest){if(this.active.has(request.castId))return false;const factory=this.factories.get(request.sourceId);if(!factory)return false;this.active.set(request.castId,{request,player:factory(request),frame:null});return true;}
+ cancel(castId:string){const item=this.active.get(castId);if(!item)return false;item.player.dispose();this.active.delete(castId);return true;}
+ clear(){for(const id of this.active.keys())this.cancel(id);}
+ sample(runId:string,simMs:number){
+  for(const [id,cast] of this.active){if(cast.request.runId!==runId){this.cancel(id);continue;}
+   const seconds=(simMs-cast.request.startedAtSimMs)/1000;
+   if(seconds>=cast.player.durationSeconds){this.cancel(id);continue;}
+   cast.frame=seconds>=0?cast.player.sample(seconds):null;
+  }
+ }
+ frames(){return [...this.active.values()].filter(x=>x.frame!==null);}
+ get size(){return this.active.size;}
+}
