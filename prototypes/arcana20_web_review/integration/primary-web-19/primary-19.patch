+// Regression for a single known source/world boundary: D's source FLOOR_FS is
+// written to RGBA8 before the additive g layer. Negative floor channels must
+// not subtract that layer. Synthetic constant inputs isolate the boundary; this
+// is not a scene/art, bloom/post, or performance approval.
+import {chromium} from 'playwright';import assert from 'node:assert/strict';
+const b=await chromium.launch({headless:true,executablePath:process.env.CHROMIUM_PATH||undefined,args:['--no-sandbox','--use-gl=angle','--use-angle=swiftshader']});
+try{const p=await b.newPage();await p.goto(process.env.SOH_URL||'http://127.0.0.1:4191/');const result=await p.evaluate(async()=>{
+ const {DWorldGpu}=await import('/src/game/arcana20/d/worldGpu.ts'),{DWarp}=await import('/src/game/arcana20/d/warp.ts');const scene=document.createElement('canvas'),light=document.createElement('canvas');for(const c of [scene,light]){c.width=480;c.height=270;}let g=scene.getContext('2d');g.fillStyle='#808080';g.fillRect(0,0,480,270);g=light.getContext('2d');g.fillStyle='#000';g.fillRect(0,0,480,270);g.fillStyle='#fff';g.fillRect(244,132,1,1);
+ const w=new DWarp(),idx=(132*480+244);w.data[idx*4+3]=25;w.influence[idx]=1;const time=(Math.PI*1.5-(1-132.5/270)*180)/8,m={a:1,b:0,c:0,d:1,x:0,y:0},gpu=new DWorldGpu(480,270);
+ const sample=legacy=>{gpu.render(scene,light,[],w,m,0,0,time,1,undefined,false,legacy);const c=document.createElement('canvas');c.width=480;c.height=270;const ctx=c.getContext('2d');ctx.drawImage(gpu.canvas,0,0);return Array.from(ctx.getImageData(244,132,1,1).data)};
+ return {corrected:sample(false),legacy:sample(true)};
+ });assert(result.corrected[0]>result.legacy[0]+25,JSON.stringify(result));console.log(JSON.stringify({scope:'synthetic RGBA8 floor-before-light ordering, not visual parity',...result}));}finally{await b.close();}
