## Full #19 authored timeline, isolated additive ribbons only, zero camera.
## The source geometry is generated by the port, not a staged battlefield.
extends SceneTree
const OUT := "res://artifacts/arcana19-cast-ribbons"
const TICKS := [72, 192, 312, 489, 510, 528, 558, 582]
class CaptureFx extends DFx:
    var capture := false
    var commands: Array[Dictionary] = []
    func clear() -> void:
        super.clear()
        commands.clear()
    func bend(_x: float, _y: float, _size: float, _ox: float, _oy: float, _absorb: float = 0.0, _chroma: float = 0.0) -> void:
        pass
    func sp(_x: float, _y: float, _size: float, _col: Color, _shape: int = DISC, _o: Dictionary = {}) -> void:
        pass
    func poly(_pts8: Array, _col: Color, _o: Dictionary = {}) -> void:
        pass
    func line(pts: Array, width: Variant, col: Variant, o: Dictionary = {}) -> void:
        if not capture or pts.size() < 4: return
        commands.append({"pts": pts.duplicate(), "width": width.duplicate() if width is Array else width, "color": col.duplicate() if col is Array else col, "opts": o.duplicate(true)})
        super.line(pts, width, col, o)
func _initialize() -> void:
    call_deferred("_run")
func _run() -> void:
    DirAccess.make_dir_recursive_absolute(OUT)
    var eng := DConstellationEngine.new()
    eng.setup()
    var fx := CaptureFx.new()
    fx.track_world_fields = true
    eng.fx = fx
    for tick in range(1, TICKS[-1] + 1):
        fx.capture = tick in TICKS
        eng.update(float(tick) / 60.0, 0.0001 if tick == 1 else 1.0 / 60.0)
        if tick not in TICKS: continue
        var calls := []
        for command in fx.commands:
            var cols := []
            var raw_col: Variant = command.color
            if raw_col is Array:
                for cc in raw_col: cols.append([cc.r, cc.g, cc.b, cc.a])
            else:
                var cc: Color = raw_col
                cols = [cc.r, cc.g, cc.b, cc.a]
            calls.append({"pts": command.pts, "width": command.width, "col": cols, "opts": command.opts})
        var json_file := FileAccess.open(OUT + "/tick%d.native.calls.json" % tick, FileAccess.WRITE)
        json_file.store_string(JSON.stringify(calls))
        json_file.close()
        var file := FileAccess.open(OUT + "/tick%d.native.rgb32f" % tick, FileAccess.WRITE)
        file.store_buffer(fx.buf.to_byte_array())
        file.close()
        file = FileAccess.open(OUT + "/tick%d.native.coverage.u8" % tick, FileAccess.WRITE)
        file.store_buffer(fx.world_influence)
        file.close()
        for mode in ["ldr", "ldr8"]:
            var clipped := DFx.new()
            clipped.track_world_fields = true
            clipped.t = fx.t
            clipped.rgba8_fragment_transfer = true
            clipped.rgba8_scene_blend = mode == "ldr8"
            for command in fx.commands:
                clipped.line(command.pts, command.width, command.color, command.opts)
            file = FileAccess.open(OUT + "/tick%d.%s.rgb32f" % [tick, mode], FileAccess.WRITE)
            file.store_buffer(clipped.buf.to_byte_array())
            file.close()
            file = FileAccess.open(OUT + "/tick%d.%s.coverage.u8" % [tick, mode], FileAccess.WRITE)
            file.store_buffer(clipped.world_influence)
            file.close()
        for coverage in [false, true]:
            var vp := SubViewport.new()
            vp.size = Vector2i(DFx.W, DFx.H)
            vp.disable_3d = true
            vp.transparent_bg = true
            vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
            root.add_child(vp)
            for command in fx.commands:
                vp.add_child(DRibbonGPU.create(command.pts, command.width, command.color, command.opts, fx.t, bool(coverage)))
            for i in range(3):
                await process_frame
                await RenderingServer.frame_post_draw
            var image := vp.get_texture().get_image()
            if image.is_empty() or image.get_size() != vp.size:
                push_error("D cast ribbon GPU output unavailable at %d" % tick)
                quit(1)
                return
            image.convert(Image.FORMAT_RGBA8)
            var suffix := ".gpu.coverage.rgba8" if coverage else ".gpu.rgba8"
            file = FileAccess.open(OUT + "/tick%d%s" % [tick, suffix], FileAccess.WRITE)
            file.store_buffer(image.get_data())
            file.close()
            vp.queue_free()
            await process_frame
        print("D19_CAST_RIBBON_NATIVE ", tick, " renderer_time=", fx.t, " commands=", fx.commands.size())
    print("D19_CAST_RIBBON_NATIVE_COMPLETE")
    quit()
