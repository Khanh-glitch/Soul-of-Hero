extends SceneTree
const F = preload("res://prototypes/gold_fidelity/gold_hairline_plate_factory.gd")
const SOURCE_TIME := 1.4666666666666663
const GOLD_SOURCE_VERTICES = [[96.392516,88.643087,145.494817,97.777958,155.102301,130.165229,106,130.165229],[108.33862,152.143932,155.102301,152.143932,160.301886,171.765897,113.538205,169.982082],[137.943054,106.918162,186.00564,112.71271,191.062586,133.257013,143,133.257013],[137.06637,151.744862,191.062586,151.744862,184.481171,167.820706,130.484955,166.359266],[179.327315,116.601162,223.361432,120.362016,224.034118,133.695954,180,133.695954],[179.120729,153.469686,224.034118,153.469686,215.238576,176.889579,170.325188,174.760498],[209.080048,109.455679,256.188438,114.66096,264.10839,133.116048,217,133.116048],[213.298038,152.964945,264.10839,152.964945,260.904015,178.167951,210.093663,175.876768],[249.153027,117.313961,296.665306,120.801259,301.51228,133.165316,254,133.165316],[256.91073,148.226911,301.51228,148.226911,298.602117,158.241515,254.000567,157.331096],[290.313911,102.082839,338.079551,108.427356,338.76564,130.921555,291,130.921555],[287.897936,153.346564,338.76564,153.346564,332.960288,168.939435,282.092584,167.521901],[321.176785,93.355691,364.345756,101.0743,371.168971,128.440274,328,128.440274],[330.213419,149.973297,371.168971,149.973297,361.7036,160.479644,320.748048,159.524521]]
func _initialize() -> void:
    var failures := 0
    var inspected := 0
    if F.PLATES.size() != 14: failures += 1
    for i in min(F.PLATES.size(), GOLD_SOURCE_VERTICES.size()):
        var live: PackedVector2Array = F.vertices_at(i, SOURCE_TIME)
        for j in 4:
            var source: Array = GOLD_SOURCE_VERTICES[i]
            var expected := Vector2(float(source[j*2]),float(source[j*2+1]))
            var offset := live[j].distance_to(expected)
            if offset > 0.002:
                push_error("Original source mismatch sheet %d vertex %d offset %.6f" % [i,j,offset])
                failures += 1
            inspected += 1
    print("GOLD_PLATE_GEOMETRY: %s  %d/56 vertices compared to real gold source" % ["PASS" if failures == 0 else "FAIL %d" % failures,inspected])
    quit(0 if failures == 0 else 1)
