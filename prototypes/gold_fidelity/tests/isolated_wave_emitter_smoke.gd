extends SceneTree
const EMITTER = preload("res://prototypes/gold_fidelity/gold_source_wave_emitter.gd")
const FIELDS = ["x","y","z","vx","vy","vz","rot","spin","s","w","h","w1","h1","life","seed","r0","r1","k1","k2","grav","drag","streak","shrink"]
var fails := 0
var checked := 0
func _compare(label: String, actual: float, source: float, tolerance := 0.0001) -> void:
    checked += 1
    if absf(actual-source)>tolerance:
        fails += 1
        push_error("%s: got %.12f vs gold %.12f" % [label,actual,source])
func _initialize() -> void:
    # Oracle generated by invoking ORIGINAL fxlib.ts on original World Part,
    # Chunk, Blob, RingFx constructors, seeded with 0x20261027.
    var e = EMITTER.new(0x20261027)
    var objects: Array[Dictionary] = e.spawn_standard_wave(Vector2(278,141),-1)
    var counts := {"blob":0,"chunk":0,"part":0,"ring":0}
    var total := 0.0
    var total_sq := 0.0
    var scalar_count := 0
    for i in objects.size():
        var obj: Dictionary = objects[i]
        var kind: String = String(obj["kind"])
        counts[kind] = int(counts[kind]) + 1
        var attrs: Dictionary = obj["source"]
        for k in FIELDS.size():
            var key: String = FIELDS[k]
            if attrs.has(key):
                var weighted: float = float(attrs[key])*(1.0+float(i%7)*0.01+float(k)*0.001)
                total += weighted
                total_sq += weighted*weighted
                scalar_count += 1
    _compare("object count",objects.size(),22)
    _compare("blobs",counts["blob"],7)
    _compare("shards",counts["chunk"],9)
    _compare("sparks",counts["part"],5)
    _compare("rings",counts["ring"],1)
    _compare("scalar count",scalar_count,212)
    _compare("seeded weighted checksum",total,13386.395138464488,0.005)
    _compare("seeded squared checksum",total_sq,3301661.2759086434,0.1)
    _compare("seeded RNG final state",float(e.random_state()),1023886811.0,0)
    _compare("ground crack angle",e.crack_angle,1.0356469433896731)
    _compare("source flash seed",float(objects[0]["source"]["seed"]),6.117601008154452)
    _compare("source shard vx",float(objects[1]["source"]["vx"]),-46.560993181758406)
    _compare("source shard vy",float(objects[1]["source"]["vy"]),-129.15384865264932)
    _compare("source shard vz",float(objects[1]["source"]["vz"]),72.38689214922488)
    print("GOLD_WAVE_EMITTER: %s %d checks" % ["PASS" if fails==0 else "FAIL",checked])
    quit(0 if fails==0 else 1)
