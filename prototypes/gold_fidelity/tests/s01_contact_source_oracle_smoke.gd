extends SceneTree

## Oracle generated by COMPILING and EXECUTING original user Gold TypeScript
## actors.ts Enemy, fxlib.ts contact(), world.ts Blob/Part/LightFx.
## Local source RNG was patched with the same fixed 32-bit LCG used in VFX
## image reference tests; original Enemy() constructor consumes one RNG draw.
const EMITTER = preload("res://prototypes/gold_fidelity/gold_s01_contact_source.gd")
const ACTOR = preload("res://prototypes/gold_fidelity/gold_s01_enemy_presentation.gd")
const BLOB = preload("res://prototypes/gold_fidelity/gold_blob_primitive.gd")
const GLYPH = preload("res://prototypes/gold_fidelity/gold_rupture_glyph.gd")
const CASES = [
    {"id":0,"kind":"heavy","x":300.0,"y":150.0,"direction":PI,
        "big":true,"stop":0.09,"spikes":8,"blob_seed":2.8401014860719442,
        "rng_end":1007050371,"part_count":14,
        "first_vx":-179.1242034857198,"first_vz":33.885513320565224,
        "first_life":0.23066684445366264,
        "last_vx":-240.98791967926672,"last_life":0.29378887442871926},
    {"id":1,"kind":"grunt","x":352.0,"y":108.0,"direction":-PI/2.0,
        "big":false,"stop":0.035,"spikes":8,"blob_seed":2.8401014860719442,
        "rng_end":295381091,"part_count":6,
        "first_vx":-127.14515816129213,"first_vz":33.885513320565224,
        "first_life":0.23066684445366264,
        "last_vx":27.540602958632387,"last_life":0.2275095078162849},
    {"id":2,"kind":"grunt","x":348.0,"y":196.0,"direction":PI/2.0,
        "big":false,"stop":0.035,"spikes":8,"blob_seed":2.8401014860719442,
        "rng_end":295381091,"part_count":6,
        "first_vx":127.14515816129216,"first_vz":33.885513320565224,
        "first_life":0.23066684445366264,
        "last_vx":-27.540602958632363,"last_life":0.2275095078162849}
]

func _initialize() -> void:
    call_deferred("_run")

func _check_equal(label: String, a: float, b: float, epsilon: float = 0.00001) -> bool:
    if absf(a-b)>epsilon:
        push_error("GOLD_CONTACT_ORACLE: "+label+" expected "+str(b)+" got "+str(a))
        return false
    return true

func _run() -> void:
    var passed := 0
    var render_sources: Array = []
    for c: Dictionary in CASES:
        var enemy = ACTOR.new(int(c["id"]),String(c["kind"]),float(c["x"]),float(c["y"]))
        var source = EMITTER.new(0x20261027)
        source.source_enemy_constructor_rng_draw()
        var e: Dictionary = source.generate(enemy.center(),enemy.hc,enemy.kind,
            float(c["direction"]),bool(c["big"]),float(c["stop"]))
        var objs: Array = e["objects"]
        var expected_parts: int = int(c["part_count"])
        if objs.size()!=expected_parts+2 or String(objs[0]["kind"])!="blob" or String(objs[-1]["kind"])!="light":
            push_error("GOLD_CONTACT_ORACLE: source fx callgraph differs from original contact()")
            quit(1)
            return
        var blob: Dictionary = objs[0]["source"]
        var part: Dictionary = objs[1]["source"]
        var last: Dictionary = objs[expected_parts]["source"]
        var light: Dictionary = objs[-1]["source"]
        if not _check_equal("source x",float(blob["x"]),enemy.center().x) or             not _check_equal("source center y",float(blob["y"]),enemy.center().y) or             not _check_equal("source original flash radius",float(blob["w"]),30.0 if bool(c["big"]) else 15.0) or             not _check_equal("original flash spikes",float(blob["k1"]),float(c["spikes"])) or             not _check_equal("gold Blob seeded RNG",float(blob["seed"]),float(c["blob_seed"])) or             not _check_equal("first source spark vx",float(part["vx"]),float(c["first_vx"])) or             not _check_equal("first spark vz",float(part["vz"]),float(c["first_vz"])) or             not _check_equal("first spark life",float(part["life"]),float(c["first_life"])) or             not _check_equal("last source spark vx",float(last["vx"]),float(c["last_vx"])) or             not _check_equal("last spark life",float(last["life"]),float(c["last_life"])) or             not _check_equal("contact 46px light radius",float(light["r"]),46.0) or             not _check_equal("real source hitstop request",float(e["requested_hitstop"]),float(c["stop"])) or             int(e["rng_state_after"])!=int(c["rng_end"]) or             String(part["ramp"])!="silver" or             not bool(e["does_not_write_damage"]):
            push_error("GOLD_CONTACT_ORACLE: source numeric or visual-only contract failed on enemy id "+str(c["id"]))
            quit(1)
            return
        passed += 13
        if int(c["id"])==0:
            render_sources=objs

    # An actual Godot shader render from the SOURCE-emitted heavy contact.
    var vp := SubViewport.new()
    vp.size = Vector2i(480,270)
    vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
    root.add_child(vp)
    var bg := ColorRect.new()
    bg.size = Vector2(480,270)
    bg.color = Color8(12,11,22)
    vp.add_child(bg)
    var active: Array[Node2D] = []
    for obj: Dictionary in render_sources:
        var kind: String = String(obj["kind"])
        if kind=="light":
            continue # Original LightFx is GPU post-process, not a fake circle.
        var node: Node2D = BLOB.new() if kind=="blob" else GLYPH.new()
        vp.add_child(node)
        if kind=="blob":
            node.call("configure",obj["source"])
        else:
            node.call("configure",kind,obj["source"])
        active.append(node)
    for i in 8:
        for node: Node2D in active:
            if node is GoldBlobPrimitive:
                node.call("step_gold",1.0/60.0,float(i+1)/60.0)
            else:
                node.call("step_gold",1.0/60.0)
    await process_frame
    await RenderingServer.frame_post_draw
    var img: Image = vp.get_texture().get_image()
    if img==null or img.get_width()!=480 or img.get_height()!=270:
        push_error("GOLD_CONTACT_ORACLE: no actual Godot framebuffer")
        quit(1)
        return
    var occupied := 0
    for y in range(100,180):
        for x in range(240,365):
            var color: Color = img.get_pixel(x,y)
            if color.r>0.18 or color.g>0.18 or color.b>0.25:
                occupied += 1
    if occupied<35:
        push_error("GOLD_CONTACT_ORACLE: blank visual sample "+str(occupied))
        quit(1)
        return
    var folder := ProjectSettings.globalize_path("res://.artifacts/gold_fidelity")
    if DirAccess.make_dir_recursive_absolute(folder)!=OK or img.save_png(folder.path_join("s01_source_contact_heavy_tick8.png"))!=OK:
        push_error("GOLD_CONTACT_ORACLE: evidence screenshot not saved")
        quit(1)
        return
    print("GOLD_S01_CONTACT_ORACLE: PASS / 3 original TS cases / %d numeric checks / actual 14 silver spark and Blob render / lit=%d" % [passed,occupied])
    quit(0)
