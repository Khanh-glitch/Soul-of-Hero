]
func _initialize() -> void:
    var chain = CHAIN.new(270.25,150.75,8,4.2,0.41)
    var count := 0
    for tick in range(91):
        if tick > 0:
            var tf := float(tick)
            var x: float = 270.25+55.0*(1.0-exp(-tf/25.0))+cos(tf*0.16)*4.0
            var y: float = 150.75+18.0*sin(tf*0.09)-8.0*sin(tf*0.06)
            chain.move_head(x,y)
        for check in SNAPSHOTS:
            if int(check[0])!=tick:
                continue
            for i in range(8):
                var expected: Array = check[1][i]
                var actual: Dictionary = chain.get_segment(i)
                for key in ["x","y"]:
                    var want: float = float(expected[0 if key=="x" else 1])
                    var got: float = float(actual[key])
                    if absf(got-want)>0.000002:
                        push_error("VENOM_CHAIN_ORACLE: tick=%d segment=%d %s want=%.12f got=%.12f" % [tick,i,key,want,got])
                        quit(1)
                        return
                    count += 1
    if count!=96:
        push_error("VENOM_CHAIN_ORACLE: insufficient source samples")
        quit(1)
        return
    print("VENOM_CHAIN_ORACLE: PASS / 96 source TypeScript coordinates / 8-segment Fang / 90-tick path")
    quit(0)
