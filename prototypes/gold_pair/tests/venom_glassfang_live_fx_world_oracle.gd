extends SceneTree

## Generated by executing UNMODIFIED user TS Gold
## src/game/skills/s1.ts against original World.step(1/60).
## Gold World.seed 0x20261027; zero source enemies at World.reset,
## then elite at 375,190 with 900 HP and controlled sine positions.
## No pre-rendered frame or fake skill VFX in this test.
const LIVE=preload("res://prototypes/gold_pair/venom_glassfang_full_particle_runtime.gd")
const SOURCE_GOLD=[
    [6,0,0,539365415,0,0.0,0.0,0.0],
    [15,35,35,3675814865,1,322.570983,179.357496,12.269979],
    [31,36,38,3675814865,1,311.814176,184.869153,8.009937],
    [63,31,61,125413033,50,364.449731,192.859005,18.902590],
    [96,27,85,869978497,73,377.058625,171.769557,12.341017],
    [147,77,177,2144556934,105,404.993564,192.617693,1.313393],
    [177,90,208,3193675783,186,358.123895,179.569561,4.345400],
    [220,36,274,1715451952,272,360.597270,195.809049,5.882512],
    [330,35,448,1391500464,423,353.092740,187.316581,2.336020]
]
func _initialize()->void:
    var runtime=LIVE.new()
    runtime.begin(260.0,160.0,atan2(30.0,115.0),17,1765485952,0x20261027)
    var enemy:Dictionary={"id":17,"x":375.0,"y":190.0,
        "r":9.5,"dying":0.0,"hp":900,"exists":true}
    var bite_idx:int=0
    var verified:int=0
    for tick in range(1,331):
        enemy["x"]=375.0+8.0*sin(float(tick)*0.070)
        enemy["y"]=190.0+5.0*cos(float(tick)*0.055)
        runtime.step_source_60hz([enemy])
        # The source fixture keeps Gold elite alive at 900HP. Original Gold
        # World.hit applies damage; native motion may emit bite cues but never
        # mutates real SOH enemy HP. Here only synthetic source HP changes.
        for n in range(bite_idx,runtime.motion.bite_cues.size()):
            enemy["hp"]=int(enemy["hp"])-int(runtime.motion.bite_cues[n]["amount"])
        bite_idx=runtime.motion.bite_cues.size()
        for check in SOURCE_GOLD:
            if int(check[0])!=tick:continue
            var actual_count:int=runtime.particles().size()
            var created:int=runtime.emitters.world.n
            var state:int=runtime.emitters.rng.state
            if actual_count!=int(check[1]) or created!=int(check[2]) or state!=int(check[3]):
                push_error("VENOM_GLASSFANG_LIVE_FX_WORLD: Gold tick=%d expected count/created/rng=%s native=%s" %
                    [tick,str([check[1],check[2],check[3]]),str([actual_count,created,state])])
                quit(1)
                return
            if actual_count>0:
                var first:Dictionary=runtime.particles()[0]
                if int(first["seed"])!=int(check[4]):
                    push_error("VENOM_GLASSFANG_LIVE_FX_WORLD: source particle swap order seed drift tick=%d Gold=%d native=%d" %
                        [tick,int(check[4]),int(first["seed"])])
                    quit(1)
                    return
                for i in range(3):
                    var actual:float=float(first[["x","y","z"][i]])
                    var orig:float=float(check[5+i])
                    if absf(actual-orig)>0.00002:
                        push_error("VENOM_GLASSFANG_LIVE_FX_WORLD: tick=%d first Gold %s=%.6f native=%.8f" %
                            [tick,["x","y","z"][i],orig,actual])
                        quit(1)
                        return
            verified+=1
    if verified!=9:
        push_error("VENOM_GLASSFANG_LIVE_FX_WORLD: missing source dynamic full timeline checkpoints")
        quit(1)
        return
    print("VENOM_GLASSFANG_LIVE_FX_WORLD: PASS / original TS 330-frame continuous source World particles / 9 original checkpoints / full RNG and afterlife")
    quit(0)
