extends SceneTree

## True native Ultra k=2 source Pool.gnd + Pool.lit renderer staging.
## Original source SHA generated by unmodified Gold TS Pool at 1200x680.
## This is NOT a whole Glassfang cast or full GLSL compositing parity test.
const CANVAS=preload("res://prototypes/gold_pair/venom_source_pool_canvas.gd")
const EXPECTED_GROUND="9aadea1413c02c0d60430ad1a79d92f55afc41e2b83ba658d1e39a4ac9af1516"
const EXPECTED_LIGHT="045802ee258ba128adffee04eaa1c42f95c1de6e629b5485d16a448c7b3c8df5"

func _initialize()->void:
    call_deferred("_run")

func _run()->void:
    var viewport:=SubViewport.new()
    viewport.size=Vector2i(1200,680)
    viewport.transparent_bg=true
    viewport.render_target_update_mode=SubViewport.UPDATE_ALWAYS
    root.add_child(viewport)
    var canvas=CANVAS.new()
    canvas.set_source_density(2)
    viewport.add_child(canvas)
    canvas.begin_source_pool(391.72,176.95,6.5,4.2,3,0.3)
    canvas.set_source_to_map_transform(Transform2D.IDENTITY)
    if canvas.W!=1200 or canvas.H!=680:
        _fail("Ultra k2 canvas allocated a fake resized classic buffer")
        return
    if canvas.is_processing():
        _fail("source Pool must not use variable-rate _process")
        return
    var frames:Dictionary=canvas.seek_source_time(1.4,1.93)
    if frames.size()!=2:
        _fail("native source ground and additive light passes missing")
        return
    for pass_name in ["ground","light"]:
        var raw:PackedByteArray=frames[pass_name]
        if raw.size()!=1200*680*4:
            _fail("full Ultra buffer wrong size for "+pass_name)
            return
        var ctx:=HashingContext.new()
        ctx.start(HashingContext.HASH_SHA256)
        ctx.update(raw)
        var want:String=EXPECTED_GROUND if pass_name=="ground" else EXPECTED_LIGHT
        if ctx.finish().hex_encode()!=want:
            _fail("source Ultra original SHA drift pass="+pass_name)
            return
        if canvas.images[pass_name].get_data()!=raw:
            _fail("Image.set_data corrupted original Ultra RGBA "+pass_name)
            return
        if canvas.sprites[pass_name].texture_filter!=CanvasItem.TEXTURE_FILTER_NEAREST:
            _fail("source Ultra native nearest filter missing "+pass_name)
            return
    var material:CanvasItemMaterial=canvas.sprites["light"].material
    if material==null or material.blend_mode!=CanvasItemMaterial.BLEND_MODE_ADD:
        _fail("Gold source Pool.lit additive pass missing")
        return
    await process_frame
    await process_frame
    await RenderingServer.frame_post_draw
    for pass_name in ["ground","light"]:
        if canvas.textures[pass_name].get_image().get_data()!=frames[pass_name]:
            _fail("native OpenGL Ultra GPU texture readback differs from original "+pass_name)
            return
    var rendered:Image=viewport.get_texture().get_image()
    if rendered.get_width()!=1200 or rendered.get_height()!=680:
        _fail("native 1200x680 renderer canvas dimensions drift")
        return
    if rendered.get_pixel(784,354).a<=0.01:
        _fail("native original Ultra Pool not painted near center of authored pool")
        return
    if rendered.get_pixel(48,48).a>0.01:
        _fail("native original Ultra Pool leaked to empty region")
        return
    if rendered.save_png("/tmp/venom-pool-godot-original-ultra-k2.png")!=OK:
        _fail("cannot export real OpenGL screenshot")
        return
    canvas.seek_source_time(4.3,4.83)
    if not canvas.finished or canvas.sprites["ground"].visible or canvas.sprites["light"].visible:
        _fail("native original Ultra source Pool and light cleanup failed")
        return
    await process_frame
    await process_frame
    await RenderingServer.frame_post_draw
    var clear_frame:Image=viewport.get_texture().get_image()
    if clear_frame.get_pixel(784,354).a>0.01:
        _fail("native original Ultra Pool not cleared from framebuffer")
        return
    print("VENOM_POOL_ULTRA_GPU: PASS / original 1200x680 ground and light source SHA / real OpenGL texture pixels / original Ultra screenshot / expiry cleanup")
    quit(0)

func _fail(message:String)->void:
    push_error("VENOM_POOL_ULTRA_GPU: "+message)
    quit(1)
