class_name VenomGlassfangFullParticleRuntime
extends RefCounted

## Native dynamic source authored Glassfang Particles tick stream.
## All moving shards, drops, sparks and pool bubbles are generated by the
## ORIGINAL source generator cue events and the original CPU World update,
## not interpolated screenshots or hardcoded particle coordinates.
##
## This runtime deliberately does NOT apply gameplay damage. It emits
## acid/bite event cues; native SOH CombatDamage must confirm exactly once.
const MOTION=preload("res://prototypes/gold_pair/venom_glassfang_motion.gd")
const EMIT=preload("res://prototypes/gold_pair/venom_source_particle_emitters.gd")
const POOL=preload("res://prototypes/gold_pair/venom_source_pool_lifecycle.gd")
const F:float=1.0/60.0
var motion
var emitters
var active_pools:Array=[]
var shared_pool_hits:Dictionary={}
var cues:Array[Dictionary]=[]
var world_frame:int=0
var source_world_seed:int=0
var particle_visual_count:int=0
var current_pool_counts:Dictionary={}

func begin(px:float,py:float,angle:float,target_id:int,
        original_cast_seed:int,original_world_seed:int)->void:
    motion=MOTION.new()
    motion.begin(px,py,angle,target_id,original_cast_seed)
    emitters=EMIT.new(original_world_seed)
    active_pools.clear()
    shared_pool_hits.clear()
    cues.clear()
    world_frame=0
    source_world_seed=original_world_seed
    particle_visual_count=0

func _start_pool(c:Dictionary,has_damage:bool)->void:
    var p=POOL.new()
    p.begin(float(c["x"]),float(c["y"]),float(c["radius"]),
        float(c["life"]),emitters.rng,
        float(c.get("boil",0.0)),float(c.get("grow",0.1)),
        float(c.get("tick_every",0.7)),int(c.get("tick_amount",10)),
        int(c.get("tick_max",3)),1,has_damage)
    if has_damage:
        p.bind_shared_hits(shared_pool_hits)
    active_pools.append(p)

func _emit_source_cue(c:Dictionary)->void:
    var kind:String=String(c["kind"])
    match kind:
        "shards":
            emitters.shards(float(c["x"]),float(c["y"]),int(c["n"]),
                float(c["sp"]),int(c["c1"]),int(c["c2"]),int(c["c3"]),
                _options(c))
        "drops":
            emitters.drops(float(c["x"]),float(c["y"]),int(c["n"]),
                float(c["sp"]),int(c["c1"]),int(c["c2"]),int(c["c3"]),
                _options(c))
        "spark":
            emitters.world.add({"k":"spark","x":c["x"],"y":c["y"],
                "z":c["z"],"vx":c["vx"],"vy":c["vy"],"vz":c["vz"],
                "max":c["max"],"c1":c["c1"]})
        "trail":
            # Original trail() adds Splash and a 0.9s non-damaging Pool.
            _start_pool(c,false)
            cues.append({"kind":"splash","frame":world_frame,
                "x":c["x"],"y":c["y"],"radius":4.0,
                "c1":4281395878,"c2":4288741358})
        "aftershock_pool":
            # Source exactly three 4.2s pools share one per-enemy Hits object.
            _start_pool(c,true)
            cues.append({"kind":"embed","frame":world_frame,
                "x":float(c["x"])+1.0,"y":float(c["y"])-1.0,
                "size":c["embed_size"],"duration":6.0,
                "lit":4288723026,"dark":4282994200,"edge":4294768596})
        "vial":
            cues.append(c)
        _:
            push_error("Unported original Glassfang particle cue kind="+kind)

static func _options(c:Dictionary)->Dictionary:
    var out:Dictionary={}
    for key in ["z","size","up","land","glow","max","ang","spread"]:
        if c.has(key):out[key]=c[key]
    return out

func step_source_60hz(targets:Array)->void:
    if motion==null:
        push_error("Glassfang source World runtime must begin first")
        return
    world_frame+=1
    motion.step_60hz(targets)
    if motion.frame!=world_frame:
        push_error("Glassfang source cast tick diverged from World fixed source tick")
        return
    for c in motion.new_fx_cues:
        _emit_source_cue(c)
    # Original World.step: all FX Pool updates run in insertion order *after*
    # cast generator, and before Particles.update, sharing World RNG.
    for p in active_pools:
        p.step_source_60hz(targets,float(world_frame)*F)
        for e in p.current_frame_events:
            if String(e["k"])=="bubble":
                emitters.world.add({"k":"bubble",
                    "x":e["x"],"y":e["y"],"z":0.0,
                    "vz":e["vz"],"max":e["max"],"size":e["size"],
                    "c1":e["c1"],"c2":e["c2"],"c3":e["c3"]})
            elif String(e["k"])=="damage":
                cues.append({"kind":"acid_hit_candidate","frame":world_frame,
                    "enemy":e["id"],"amount":e["amount"],"source_id":1})
                # Original w.hit(type='acid') emits 4 droplets, but gameplay
                # authority still belongs exclusively to CombatDamage.
                emitters.drops(float(e["at_x"]),float(e["at_y"]),
                    4,40.0,4281395878,4288741358,4282871578,
                    {"z":6.65,"up":40.0,"size":[1.0,3.0]})
    for i in range(active_pools.size()-1,-1,-1):
        if active_pools[i].dead:active_pools.remove_at(i)
    emitters.world.step_source_60hz()
    for e in emitters.world.events:
        if not e.has("published"):
            var ev:Dictionary=e.duplicate()
            ev["published"]=true
            cues.append(ev)
            e["published"]=true
    particle_visual_count=emitters.world.list.size()
    current_pool_counts={"active_pools":active_pools.size(),
        "shared_hit_targets":shared_pool_hits.size(),
        "source_world_rng":emitters.rng.state}

func particles()->Array:
    return emitters.world.list if emitters!=null else []

func stats()->Dictionary:
    return {"source_frame":world_frame,
        "particles":particle_visual_count,
        "issued_fx_cues":motion.all_fx_cues.size(),
        "active_pools":active_pools.size(),
        "native_source_world_rng":emitters.rng.state,
        "acid_candidate_count":cues.filter(func(x):return String(x["kind"])=="acid_hit_candidate").size(),
        "shared_enemy_hit_ledger":shared_pool_hits.size()}
