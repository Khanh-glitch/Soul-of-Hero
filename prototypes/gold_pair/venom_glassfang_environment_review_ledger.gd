static func _ev(row:String)->Dictionary:
    var parts:PackedStringArray=row.split("|")
    var v:PackedStringArray=parts[1].split(",")
    var e:Dictionary={"age":float(v[0]),"x":float(v[1]),"y":float(v[2])}
    match parts[0]:
        "s":
            e.merge({"kind":"splash","radius":float(v[3]),"c1":int(v[4]),"c2":int(v[5])})
        "f":
            e.merge({"kind":"flash","radius":float(v[3]),"color":int(v[4]),
                "duration":float(v[5]),"z":float(v[6])})
        "r":
            e.merge({"kind":"ring","radius":float(v[3]),"duration":float(v[4]),
                "colors":[int(v[5]),int(v[6]),int(v[7])],
                "width":float(v[8]),"r0":float(v[9]),"ease":float(v[10])})
        "e":
            e.merge({"kind":"embed","size":float(v[3]),"lit":int(v[4]),
                "dark":int(v[5]),"edge":int(v[6]),"duration":float(v[7])})
    return e

static func snapshot(tick:int)->Array:
    var result:Array=[]
    if not SNAPSHOTS.has(tick):return result
    for row in SNAPSHOTS[tick]:result.append(_ev(String(row)))
    return result
